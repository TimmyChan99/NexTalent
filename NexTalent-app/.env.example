POSTGRES_DB=nextalent
POSTGRES_USER=nextalent
POSTGRES_PASSWORD=nextalent_demo_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nextalent:nextalent_demo_password@postgres:5432/nextalent

MONGO_ROOT_USER=nextalent
MONGO_ROOT_PASSWORD=nextalent_mongo_password
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=nextalent_cv
MONGO_URL=mongodb://nextalent:nextalent_mongo_password@mongo:27017/?authSource=admin

BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-this-demo-secret-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# WF-01 Langflow webhook. Leave empty to use the built-in demo response.
LANGFLOW_WEBHOOK_URL=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_SECONDS=600
LANGFLOW_TEST_MODE=true

MAX_CV_SIZE_MB=5
UPLOAD_DIR=/app/uploads
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
